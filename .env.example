# Barrière optionnelle réservée aux environnements de prévisualisation.
PREVIEW_AUTH_ENABLED=false
PREVIEW_AUTH_PASSWORD_HASH=
PREVIEW_AUTH_SECRET=

# Origine canonique des URLs SEO. Laisser vide pour https://mycore.work.
# La valeur doit être une origine absolue sans chemin, requête ni fragment.
NEXT_PUBLIC_SITE_URL=
# Ajouter la valeur fournie par Google uniquement si Search Console est configurée.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Mesure d’audience Core (consentement obligatoire, désactivée par défaut).
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# En production, chemin absolu vers SQLite hors du dépôt (ex. /var/lib/core/analytics.sqlite).
ANALYTICS_DATABASE_PATH=
ANALYTICS_COOKIE_SECRET=
# Chemin absolu vers le fichier GeoLite2-Country.mmdb, facultatif.
ANALYTICS_GEOIP_DATABASE_PATH=
# À activer uniquement derrière le Caddy de confiance qui renseigne X-Forwarded-For.
ANALYTICS_TRUST_PROXY_HEADERS=false

# Administration privée. Hash bcrypt ($2b$...) et secrets d’au moins 32 caractères.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
